# ─────────────────────────────────────────────────────────────────────────────
# Local development configuration. Copy to .env:  cp .env.example .env
# The keys below are DEV-ONLY sample values committed for convenience. Production
# secrets come from AWS Secrets Manager via External Secrets (see infra/k8s), never git.
# Generate fresh ones with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
APP_TIMEZONE=Asia/Kolkata

# Host ports from docker-compose (5433 avoids clashing with a local Postgres)
DATABASE_URL=postgres://amrutam:amrutam@localhost:5433/amrutam
# DATABASE_READ_URL=postgres://amrutam:amrutam@localhost:5433/amrutam   # read replica in prod
REDIS_URL=redis://localhost:6380

# JWT keyring "kid:secret,...", rotate by adding a key + switching JWT_ACTIVE_KID
JWT_SIGNING_KEYS=dev-2026-01:Tt0HZX3tfdtd6rrLkwsatOg12vt-M6TE-dev-only-signing-key
JWT_ACTIVE_KID=dev-2026-01

# PHI field-encryption keyring "keyId:base64(32 bytes),..."
ENCRYPTION_KEYS=k1:A1QQrGS1PJ9aRpjMtpYyWeNH3XYOeMvnBwuEvs9SeGU=
ENCRYPTION_ACTIVE_KEY_ID=k1
BLIND_INDEX_KEY=0bOuhoApKeVy4e_CEWgWtrLxg0ilvfqE-dev-only

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=EZaT8Sk1TVcweG7NBCu2zc_NNFydLChb-dev-only
MOCK_GATEWAY_FAILURE_RATE=0
MOCK_CHECKOUT_ENABLED=true

# SeaweedFS (S3-compatible, free, local)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=amrutam-prescriptions
S3_ACCESS_KEY_ID=amrutam
S3_SECRET_ACCESS_KEY=amrutam-dev-secret

# Mailpit (local SMTP sink, UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

CORS_ORIGINS=http://localhost:5173
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
